# Copy these variable names into Vercel:
# Project Settings -> Environment Variables
#
# Add the server-only variables to Production, Preview, and Development.
# Add the VITE_ variables to the environments where the frontend runs.

# ============================================================
# SERVER-ONLY VARIABLES
# Never add VITE_ to these names.
# ============================================================

# Razorpay Dashboard API credentials.
# Use matching TEST or matching LIVE credentials.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret

# Razorpay Dashboard -> Settings -> Webhooks -> Secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Activepieces trigger URL.
# Create an Activepieces webhook trigger and paste its URL here.
ACTIVEPIECES_BOOKING_WEBHOOK_URL=https://cloud.activepieces.com/api/v1/webhooks/replace_with_your_webhook_id

# ============================================================
# FRONTEND VARIABLES
# These are safe to expose because they use the VITE_ prefix.
# ============================================================

# Must match RAZORPAY_KEY_ID above.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_w ith_the_matching_key_id

# Your public Calendly event URL.
VITE_CALENDLY_URL=https://calendly.com/hetsuthar2157/neno-dialer-consultation-call
