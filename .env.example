# Razorpay Test Mode API Credentials
# Replace these with your actual Test Mode Key ID and Secret from Razorpay Dashboard
# NEVER commit your actual .env file or expose RAZORPAY_KEY_SECRET in frontend code!

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Frontend Public Key ID (defaults to RAZORPAY_KEY_ID if passed from backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
