# ============================================================
# BACKEND-ONLY SECRETS — NEVER prefix with VITE_
# These are read only by /api/* serverless functions on Vercel.
# ============================================================

# Razorpay API credentials (Live Mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret
# Get from: Razorpay Dashboard → Settings → Webhooks → Create/Edit Webhook → Secret
# Register webhook URL as: https://your-domain.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Power Automate HTTP trigger URL (KEEP SECRET — backend only)
POWER_AUTOMATE_BOOKING_WEBHOOK_URL=https://your-power-automate-webhook-url

# ============================================================
# FRONTEND PUBLIC VARIABLES — safe to expose via VITE_ prefix
# ============================================================

# Razorpay PUBLIC key — safe to expose in browser.
# MUST match RAZORPAY_KEY_ID exactly (both live or both test, never mixed).
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx

# Microsoft Bookings public scheduling page URL
VITE_MICROSOFT_BOOKINGS_URL=https://bookings.cloud.microsoft/book/your-service@yourdomain.com/

